{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coinbox",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The SAME database_id as Odometry. One D1 for both portals: users is
  // shared, and transactions will reference vehicles. The migrations folder
  // is shared too, at the workspace root, because D1's migration ledger is a
  // single filename-keyed table -- two folders against one database would
  // silently skip each other's migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleet",
      "database_id": "e4bdd9c3-e885-42de-a709-4daf8f4a6edb",
      "migrations_dir": "../../migrations"
    }
  ],
  // Simulates an identity for `wrangler dev` and tests only; ignored in
  // production. A DIFFERENT aud from Odometry's on purpose -- each portal has
  // its own Access application, and accepting the other's audience would let
  // a token minted for the fleet portal open the ledger.
  "access": {
    "dev": {
      "aud": "coinbox-dev",
      "identity": {
        "email": "hazriq.fitri95@gmail.com",
        "name": "Dev User"
      }
    }
  },
  // 17:00 UTC = 01:00 Asia/Kuala_Lumpur, one hour into the owner's day, so a
  // rule due on the 15th has posted before he wakes on the 15th.
  //
  // DELIBERATELY ONE HOUR BEFORE fleet-portal's 18:00 UTC backup, so the
  // night's auto-posted entries are in that night's dump. Do not invert these.
  //
  // Correctness does not depend on the hour: the runner posts only
  // occurrences dated on or before todayIn(owner.timezone), so it can be late
  // by at most one run and can never be early, in any timezone.
  //
  // A newly registered Cron Trigger takes ~15 minutes to start firing. Check
  // how long ago this deployed before concluding it is broken.
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  // This job writes money and nobody is watching it. Without persisted logs a
  // failed run leaves no evidence at all -- `wrangler tail` prints nothing
  // from a non-interactive shell, even for live traffic.
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "effortless-hf95.cloudflareaccess.com",
    // The Application Audience (AUD) Tag from Cloudflare One > Access >
    // Applications > coinbox. MUST differ from Odometry's: accepting the
    // other portal's audience would let a token minted for the fleet portal
    // open the ledger. Rename the team or recreate the Access application
    // without updating this and every request 401s.
    "ACCESS_AUD": "72edbf25e9c4affaac78778e280350df57de7b4a65ea08ccb76b9ded85da1238"
  }
}
