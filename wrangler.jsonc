{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Admin-only config. This declares NO Worker (`main` is absent on purpose) and is
  // never deployed. It exists so that `wrangler d1 ...` commands have one unambiguous
  // home for the shared database, rather than one portal's config having to drive
  // migrations that belong to the other. See CLAUDE.md, "One database, one ledger".
  "name": "portals-db-admin",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleet",
      "database_id": "e4bdd9c3-e885-42de-a709-4daf8f4a6edb",
      "migrations_dir": "./migrations"
    }
  ]
}
