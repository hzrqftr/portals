{
  "name": "fleet-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run lint:isolation && npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:isolation": "node scripts/check-db-imports.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:apply:local": "wrangler d1 migrations apply fleet --local",
    "db:apply:remote": "wrangler d1 migrations apply fleet --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
